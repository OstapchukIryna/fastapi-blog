        {
          "name": "Update user - partial",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "description": "PATCH applies only the fields that arrived. An omitted field is left alone rather than nulled.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUsername}}+changed@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const user = pm.response.json();",
                  "",
                  "pm.test(\"changes the field that was sent\", () =>",
                  "    pm.expect(user.email).to.include(\"+changed@example.com\"));",
                  "",
                  "pm.test(\"leaves the field that was not sent alone\", () =>",
                  "    pm.expect(user.username).to.eql(pm.collectionVariables.get(\"newUsername\")));"
                ]
              }
            }
          ]
        },
        {
