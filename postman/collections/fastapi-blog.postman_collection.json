        {
          "name": "Create post - empty fields are refused",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "This is the exact response the browser turns into field errors: static/js/utils.js reads loc for the field name and ctx for the limit. If this shape changes, the form stops explaining itself.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"summary\": \"\",\n  \"content\": \"\",\n  \"tags\": [],\n  \"user_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Content\", () => pm.response.to.have.status(422));",
                  "",
                  "const detail = pm.response.json().detail;",
                  "",
                  "pm.test(\"all three empty fields are reported\", () => {",
                  "    const fields = detail.map((e) => e.loc[e.loc.length - 1]);",
                  "    [\"title\", \"summary\", \"content\"].forEach((f) => pm.expect(fields).to.include(f));",
                  "});",
                  "",
                  "pm.test(\"loc is [body, field] so the browser can find the input\", () =>",
                  "    detail.forEach((e) => {",
                  "        pm.expect(e.loc[0]).to.eql(\"body\");",
                  "        pm.expect(e.loc.length).to.be.at.least(2);",
                  "    }));",
                  "",
                  "pm.test(\"carries type and ctx, which the browser turns into wording\", () => {",
                  "    const title = detail.find((e) => e.loc[e.loc.length - 1] === \"title\");",
                  "    pm.expect(title.type).to.eql(\"string_too_short\");",
                  "    pm.expect(title.ctx.min_length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test(\"detail adds content on top of the list shape\", () => {",
                  "    pm.expect(post).to.have.property(\"content\");",
                  "    pm.expect(Object.keys(post).sort()).to.eql(",
                  "        [\"author\", \"content\", \"date_posted\", \"id\", \"is_pinned\", \"summary\", \"tags\", \"title\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post - unknown id is 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts/99999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "99999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"says what was not found\", () =>",
                  "    pm.expect(pm.response.json().detail).to.eql(\"Post not found\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update post - partial leaves the rest alone",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Retitled by Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test(\"the sent field changed\", () => pm.expect(post.title).to.eql(\"Retitled by Postman\"));",
                  "",
                  "pm.test(\"the fields that were not sent are untouched\", () => {",
                  "    pm.expect(post.summary).to.eql(\"Created by the collection run.\");",
                  "    pm.expect(post.tags).to.eql([\"python\", \"async\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update post - empty body changes nothing",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "exclude_unset means an absent field is not a change. An empty body is a legitimate no-op, not an error.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test(\"still the values from the previous request\", () => {",
                  "    pm.expect(post.title).to.eql(\"Retitled by Postman\");",
                  "    pm.expect(post.tags).to.eql([\"python\", \"async\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update post - empty tag list clears them",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "Tags are replaced wholesale rather than merged, so sending [] clears them while omitting the key keeps them.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"tags are gone\", () => pm.expect(pm.response.json().tags).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace post - PUT overwrites every field",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "PUT is a full replacement: nothing is left alone, which is what separates it from the PATCH above.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Replaced by Postman\",\n  \"summary\": \"Whole-post replacement.\",\n  \"content\": \"Replaced body.\",\n  \"tags\": [\n    \"sql\"\n  ],\n  \"user_id\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.user_id = Number(pm.collectionVariables.get(\"userId\"));",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test(\"every field is the one just sent\", () => {",
                  "    pm.expect(post.title).to.eql(\"Replaced by Postman\");",
                  "    pm.expect(post.summary).to.eql(\"Whole-post replacement.\");",
                  "    pm.expect(post.content).to.eql(\"Replaced body.\");",
                  "    pm.expect(post.tags).to.eql([\"sql\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));",
                  "",
                  "pm.test(\"no body - there is nothing to say about a post that is gone\", () =>",
                  "    pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete post - deleting it again is 404",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "DELETE is idempotent in its effect - the post is gone either way - but the second call honestly reports that there was nothing at that id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ],
      "description": "The full life of a post, plus the PATCH/PUT distinction and the 422 shape the browser depends on."
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "List tags with counts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tags",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            },
            "description": "Ordered by count descending, then by name, so the ordering is defined even when counts tie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const tags = pm.response.json();",
                  "",
                  "pm.test(\"returns a list of name and count\", () => {",
                  "    pm.expect(tags).to.be.an(\"array\");",
                  "    if (tags.length) pm.expect(Object.keys(tags[0]).sort()).to.eql([\"count\", \"name\"]);",
                  "});",
                  "",
                  "pm.test(\"sorted by count desc, then name asc\", () => {",
                  "    const sorted = [...tags].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));",
                  "    pm.expect(tags).to.eql(sorted);",
                  "});",
                  "",
                  "pm.test(\"only tags that are actually used appear\", () =>",
                  "    tags.forEach((t) => pm.expect(t.count).to.be.above(0)));",
                  "",
                  "if (tags.length) pm.collectionVariables.set(\"knownTag\", tags[0].name);"
                ]
              }
            }
          ]
        },
        {
          "name": "List posts for a tag",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tags/{{knownTag}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags",
                "{{knownTag}}",
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const posts = pm.response.json();",
                  "const tag = pm.collectionVariables.get(\"knownTag\");",
                  "",
                  "pm.test(\"returns a list\", () => pm.expect(posts).to.be.an(\"array\"));",
                  "",
                  "pm.test(\"every post really carries the tag\", () =>",
                  "    posts.forEach((p) => pm.expect(p.tags).to.include(tag)));"
                ]
              }
            }
          ]
        },
        {
          "name": "List posts for a tag - unknown tag is 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tags/no-such-tag-exists/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tags",
                "no-such-tag-exists",
                "posts"
              ]
            },
            "description": "An unused tag is not an empty list: the tag itself does not exist, and saying so is more useful than an empty array."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ],
      "description": "The tag index and its ordering rule."
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete the user this run created",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Deleting a user cascades to their posts, so the run leaves the database as it found it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "The user is gone",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "",
                  "// Leave no run-specific state behind, so a second run in the same Postman",
                  "// session starts from the same place as the first.",
                  "[\"userId\", \"postId\", \"newUsername\", \"newEmail\", \"knownTag\"].forEach((v) =>",
                  "    pm.collectionVariables.unset(v));"
                ]
              }
            }
          ]
