          "    pm.expect(pm.response.code, `server error: ${pm.response.text().slice(0, 200)}`)",
          "        .to.be.below(500));",
          "",
          "const type = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (type.includes(\"application/json\")) {",
          "    pm.test(\"body is valid JSON\", () => pm.response.to.be.json);",
          "}"
