    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "PostResponse, not PostDetail: the list deliberately carries no body text."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const posts = pm.response.json();",
                  "",
                  "pm.test(\"returns a list\", () => pm.expect(posts).to.be.an(\"array\"));",
                  "",
                  "if (posts.length) {",
                  "    pm.test(\"shape is exactly PostResponse\", () =>",
                  "        pm.expect(Object.keys(posts[0]).sort()).to.eql(",
                  "            [\"author\", \"date_posted\", \"id\", \"is_pinned\", \"summary\", \"tags\", \"title\"]));",
                  "",
                  "    pm.test(\"the list carries no content - that is PostDetail's job\", () =>",
                  "        pm.expect(posts[0]).to.not.have.property(\"content\"));",
                  "",
                  "    pm.test(\"tags are flat strings, not objects\", () => {",
                  "        pm.expect(posts[0].tags).to.be.an(\"array\");",
                  "        posts[0].tags.forEach((t) => pm.expect(t).to.be.a(\"string\"));",
                  "    });",
                  "",
                  "    pm.test(\"author is embedded, not just an id\", () =>",
                  "        pm.expect(posts[0].author).to.have.property(\"username\"));",
                  "",
                  "    pm.test(\"newest first\", () => {",
                  "        const dates = posts.map((p) => Date.parse(p.date_posted));",
                  "        pm.expect(dates).to.eql([...dates].sort((a, b) => b - a));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "The tags sent here are deliberately messy: mixed case, padded, and a duplicate. normalise_tags trims, lowercases and de-duplicates while keeping order.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Posted from Postman\",\n  \"summary\": \"Created by the collection run.\",\n  \"content\": \"## Heading\\n\\nBody text.\",\n  \"tags\": [\n    \"Python\",\n    \"  python  \",\n    \"Async\"\n  ],\n  \"user_id\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// user_id is an integer in the schema, and a collection variable",
                  "// interpolates as a string. Substituted into the body as a number.",
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.user_id = Number(pm.collectionVariables.get(\"userId\"));",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test(\"tags are trimmed, lowercased and de-duplicated, order kept\", () =>",
                  "    pm.expect(post.tags).to.eql([\"python\", \"async\"]));",
                  "",
                  "pm.test(\"belongs to the user this run created\", () =>",
                  "    pm.expect(post.author.id).to.eql(Number(pm.collectionVariables.get(\"userId\"))));",
                  "",
                  "pm.test(\"a new post is not pinned\", () => pm.expect(post.is_pinned).to.be.false);",
                  "",
                  "pm.test(\"detail carries the body text\", () =>",
                  "    pm.expect(post.content).to.include(\"Body text.\"));",
                  "",
                  "pm.test(\"date_posted parses as a date\", () =>",
                  "    pm.expect(Date.parse(post.date_posted)).to.be.a(\"number\").and.not.NaN);",
                  "",
                  "pm.collectionVariables.set(\"postId\", post.id);"
                ]
              }
            }
          ]
        },
