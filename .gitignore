# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.DS_Store
.AppleDouble
.LsOverride
*.py[cod]

# Virtual environments
.venv
.env

# Local Claude settings
.claude/

# Machine state of the Postman extension: workspace links and auth.
# The collection itself lives under postman/ and is committed — CI builds
# the Newman JSON from it, so ignoring it turned the api job red.
.postman/
postman/collection.json

# Загруженные аватары — пользовательские данные, а не исходник:
# заглушка по умолчанию лежит в static/. .gitkeep оставлен, потому что
# StaticFiles монтирует каталог при старте и падает, если его нет.
media/profile_pics/*
!media/profile_pics/.gitkeep

# Database files. blog.db is still tracked from before this rule; see
# `git ls-files blog.db`. Ignoring a tracked file does not untrack it.
*.sqlite3
*.db

# Machine state of Impeccable; config.json, design.json are commited
.impeccable/live/sessions/
.impeccable/hook.cache.json

.github/hooks/

Icon

# Playwright: снимки и трассы упавших прогонов
test-results/
site/
