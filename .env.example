# Copy to .env and fill in. config.py reads this file; .env itself is not
# in the repository, so without it the application refuses to start.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # SECRET_KEY

# Signs the JWTs. No default on purpose — a shipped default secret is one
# everybody knows. Changing it invalidates every token already issued.
SECRET_KEY=

# Defaults live in config.py; set these only to override.
# ALGORITHM=HS256
# ACCESSE_TOKEN_EXPIRE_MINUTES=30

# Where the database lives. The default is the committed blog.db;
# scripts/api-tests.sh points this at a throwaway file of its own.
# DATABASE_URL=sqlite+aiosqlite:///./blog.db
