# Copy to .env and fill in. core/config.py reads this file; .env itself is
# not in the repository, so without it the application refuses to start.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # SECRET_KEY

# Signs the JWTs. No default on purpose — a shipped default secret is one
# everybody knows. Changing it invalidates every token already issued.
SECRET_KEY=

# MAIL_SERVER=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@called.mad.me
# MAIL_USE_TLS=true
# FRONTEND_URL=http://localhost:8000
#DATABASE_URL=postgresql+psycopg://bloguser:blogpassword@localhost/blog